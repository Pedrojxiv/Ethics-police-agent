# Copie para .env e preencha. Nunca commite o .env.

# Token do bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# URL de produção do webhook do n8n (nó "Receber Mensagem do Discord")
N8N_WEBHOOK_URL=

# Senha compartilhada: o mesmo valor da credencial Header Auth no n8n
# (header X-Moderation-Secret)
N8N_WEBHOOK_SECRET=
